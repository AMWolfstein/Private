{
  "languages": {
    "dart": {
      "extensions": [
        ".dart"
      ],
      "tests": [
        "test/*",
        "integration_test/*"
      ]
    },
    "rust": {
      "extensions": [
        ".rs"
      ],
      "tests": [
        "*/tests/*",
        "tests/*"
      ]
    },
    "kotlin": {
      "extensions": [
        ".kt",
        ".kts"
      ],
      "tests": [
        "*/src/test/*",
        "*/src/androidTest/*"
      ]
    },
    "cpp": {
      "extensions": [
        ".cpp",
        ".cc",
        ".c",
        ".h",
        ".hpp",
        ".cxx"
      ],
      "tests": [
        "tests/*",
        "*/tests/*",
        "*_test.cpp",
        "test_*.cpp"
      ]
    },
    "java": {
      "extensions": [
        ".java"
      ],
      "tests": [
        "*/src/test/*",
        "*/src/androidTest/*"
      ]
    }
  },
  "protected": [
    "third_party/*",
    "rust_backend/vendor/*",
    "rust_backend/target/*",
    "*.g.dart",
    "*.freezed.dart",
    "lib/l10n/app_localizations*.dart"
  ],
  "categories": {
    "dead-code": {
      "dart": [
        "unused_import",
        "unused_shown_name",
        "duplicate_import",
        "unnecessary_import",
        "unused_element",
        "unused_element_parameter",
        "unused_field",
        "unused_local_variable",
        "unused_catch_clause",
        "unused_catch_stack",
        "unused_label",
        "unreachable_from_main",
        "dead_code",
        "dead_code_catch_following_catch",
        "dead_code_on_catch_subtype"
      ],
      "rust": [
        "dead_code",
        "unused_imports",
        "unused_variables",
        "unused_mut",
        "unused_assignments",
        "unused_macros",
        "unreachable_code",
        "unreachable_patterns"
      ],
      "kotlin": [
        "ObsoleteSdkInt",
        "UnusedResources",
        "UnusedIds"
      ],
      "java": [
        "ObsoleteSdkInt",
        "UnusedResources",
        "UnusedIds"
      ],
      "cpp": [
        "clang-diagnostic-unused-*",
        "clang-diagnostic-unreachable-code*",
        "clang-analyzer-deadcode.*",
        "misc-unused-*"
      ]
    },
    "optimization": {
      "dart": [
        "prefer_const_constructors",
        "prefer_const_literals_to_create_immutables",
        "prefer_const_declarations"
      ],
      "rust": [
        "clippy::useless_vec",
        "clippy::slow_vector_initialization",
        "clippy::manual_memcpy",
        "clippy::vec_init_then_push"
      ],
      "kotlin": [
        "DrawAllocation",
        "UseSparseArrays",
        "UseValueOf"
      ],
      "java": [
        "DrawAllocation",
        "UseSparseArrays",
        "UseValueOf"
      ],
      "cpp": [
        "performance-*"
      ]
    },
    "simplifier": {
      "dart": [
        "unnecessary_new",
        "unnecessary_this",
        "unnecessary_lambdas",
        "unnecessary_null_checks",
        "unnecessary_parenthesis",
        "unnecessary_null_in_if_null_operators",
        "unnecessary_to_list_in_spreads",
        "prefer_if_null_operators",
        "prefer_null_aware_operators",
        "prefer_is_empty",
        "prefer_is_not_empty"
      ],
      "rust": [
        "clippy::needless_borrow",
        "clippy::redundant_closure",
        "clippy::collapsible_if",
        "clippy::let_and_return",
        "clippy::needless_return",
        "clippy::unnecessary_lazy_evaluations",
        "clippy::manual_unwrap_or_default",
        "clippy::unnecessary_map_or"
      ],
      "kotlin": [
        "ObsoleteSdkInt",
        "UseKtx",
        "ReplaceStringBuilder"
      ],
      "java": [
        "ObsoleteSdkInt",
        "UseKtx",
        "ReplaceStringBuilder"
      ],
      "cpp": [
        "readability-redundant-*",
        "readability-container-size-empty",
        "modernize-use-nullptr",
        "modernize-use-equals-default"
      ]
    }
  },
  "tools": {
    "dart": {
      "run": [
        "dart",
        "analyze",
        "--format=machine"
      ],
      "parser": "dart-machine",
      "cwd": ".",
      "timeout": 1800
    },
    "rust": {
      "run": [
        "cargo",
        "+1.99.1",
        "check",
        "--workspace",
        "--all-targets",
        "--locked",
        "--message-format=json"
      ],
      "parser": "cargo-json",
      "cwd": "rust_backend",
      "timeout": 2400
    },
    "kotlin": {
      "runner": "android-lint",
      "cwd": "android",
      "variant": "Debug",
      "timeout": 1800,
      "source_roots": [
        "android/app/src/main/",
        "android/app/src/debug/",
        "android/app/src/test/",
        "android/app/src/androidTest/",
        "android/app/src/testDebug/",
        "android/app/src/androidTestDebug/",
        "android/app/src/rust/kotlin/"
      ]
    },
    "cpp": {
      "runner": "clang-tidy",
      "timeout": 300,
      "database_globs": [
        "android/app/.cxx/Debug/*/arm64-v8a/compile_commands.json",
        "build/.cxx/debug/*/arm64-v8a/compile_commands.json"
      ]
    },
    "java": {
      "runner": "android-lint",
      "cwd": "android",
      "variant": "Debug",
      "timeout": 1800,
      "source_roots": [
        "android/app/src/main/",
        "android/app/src/debug/",
        "android/app/src/test/",
        "android/app/src/androidTest/",
        "android/app/src/testDebug/",
        "android/app/src/androidTestDebug/",
        "android/app/src/rust/kotlin/"
      ]
    }
  },
  "notes": [
    "Curated diagnostic allowlists, not exhaustive proof of dead code or performance gains.",
    "Optimization hints require measurement; simplifications require behavior verification.",
    "Generated/vendored paths are protected. Android Lint covers configured app variant/source roots, not general unused public declarations. C++ uses only the selected compilation database/configuration; missing TU/header commands remain gaps."
  ],
  "coverage": {
    "dart": {
      "lcov": "coverage/lcov.info",
      "cwd": ".",
      "produce": "flutter test --coverage"
    },
    "rust": {
      "lcov": "rust_backend/target/lcov.info",
      "cwd": "rust_backend",
      "produce": "cargo +1.99.1 llvm-cov --workspace --locked --lcov --output-path target/lcov.info (from rust_backend, optional cargo-llvm-cov required)"
    }
  }
}
