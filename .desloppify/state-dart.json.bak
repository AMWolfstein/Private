      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "services/ is a 41-file catch-all that also owns glass rendering and UI navigation state",
      "detail": {
        "holistic": true,
        "dimension": "high_level_elegance",
        "related_files": [
          "lib/services/sistrum_glass_warmup.dart",
          "lib/services/sistrum_glass_auto_probe.dart",
