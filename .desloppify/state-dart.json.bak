    "review::.::holistic::cross_module_architecture::album_artist_utils_screen_cycle": {
      "id": "review::.::holistic::cross_module_architecture::album_artist_utils_screen_cycle",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Album, artist and clickable-metadata form an import cycle through a utils helper that imports screens",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "lib/screens/local_album_screen.dart",
          "lib/screens/local_artist_screen.dart",
          "lib/utils/clickable_metadata.dart",
          "lib/widgets/local_song_menu.dart"
        ],
        "evidence": [
          "lib/utils/clickable_metadata.dart:3-4 imports lib/screens/local_album_screen.dart and lib/screens/local_artist_screen.dart.",
          "lib/screens/local_album_screen.dart:42 imports lib/utils/clickable_metadata.dart and :27 imports lib/widgets/local_song_menu.dart, which imports lib/utils/clickable_metadata.dart (line 8).",
          "lib/screens/local_artist_screen.dart:16 imports lib/screens/local_album_screen.dart; packet dependencies.cycle_summaries lists the 4-file cycle local_album_screen -> local_artist_screen -> clickable_metadata -> local_song_menu."
        ],
        "suggestion": "Move the album/artist navigation helpers out of utils/clickable_metadata.dart into a route or navigation module that depends only on route builders, and have the screens import that module. Then utils no longer imports screens and the cycle breaks.",
        "reasoning": "",
        "summary_hash": "99397145"
      },
      "status": "fixed",
      "note": "No file outside lib/screens, app.dart and main.dart imports a screen now; the utils cycle through screens is gone, verified by grep.",
      "first_seen": "2026-10-29T06:58:25+00:00",
      "last_seen": "2026-10-29T06:58:25+00:00",
      "resolved_at": "2026-10-29T14:07:53+00:00",
      "reopen_count": 0,
      "work_item_kind": "review_defect",
      "issue_kind": "review_defect",
      "origin": "review_import",
