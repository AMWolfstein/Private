  "usbBitPerfect": "Hi-res और bit-perfect ऑडियो",
  "usbBitPerfectDescription": "संगत आउटपुट पर स्रोत की सटीकता बनाए रखें। नीचे से सीधा USB या AAudio एक्सक्लूसिव चुनें; अन्यथा Android USB आउटपुट के लिए Android 14 या नया संस्करण चाहिए।",
  "usbHardwareVolume": "DAC का हार्डवेयर वॉल्यूम",
  "usbVolumeWarningTitle": "अपना सुनने का वॉल्यूम जाँचें",
  "usbVolumeWarning": "सीधा USB ऑडियो सामान्य प्लेबैक से कहीं ज़्यादा तेज़ हो सकता है, और फ़ोन के वॉल्यूम बटन इसे नियंत्रित नहीं कर सकते। शुरू करने से पहले DAC या एम्पलीफ़ायर का वॉल्यूम कम करें। समर्थित होने पर Sistrum कनेक्ट होते समय DAC को अधिकतम −40 dB पर सेट करता है; लेकिन यह हर एम्पलीफ़ायर या हेडफ़ोन पर सुरक्षित स्तर की गारंटी नहीं देता।",
  "usbVolumeAccept": "मैं समझ गया",
  "usbVolumeUnavailable": "प्लेबैक रोका गया है क्योंकि इस DAC में सत्यापित हार्डवेयर वॉल्यूम नियंत्रण नहीं है। DAC या एम्पलीफ़ायर का वॉल्यूम कम करें, फिर ज़रूरत हो तो फ़िक्स्ड-वॉल्यूम आउटपुट चालू करें।",
  "usbFixedVolume": "फ़िक्स्ड-वॉल्यूम USB आउटपुट की अनुमति दें",
  "usbFixedVolumeDescription": "उन DAC के लिए जिनमें ऐप की पहुँच वाला वॉल्यूम नियंत्रण नहीं है। जिन USB हेडसेट में अपना वॉल्यूम नियंत्रण नहीं है, उनके लिए बंद रखें। अगले ट्रैक से लागू होगा।",
  "usbFixedVolumeWarning": "ऐप इस आउटपुट का वॉल्यूम कम नहीं कर सकता। ऑडियो पूरे स्तर पर शुरू हो सकता है, और फ़ोन का वॉल्यूम स्लाइडर मदद नहीं करेगा। वॉल्यूम कम करने के बाद ही आगे बढ़ें।",
  "dapExclusive": "DAP hi-res (AAudio एक्सक्लूसिव)",
  "dapExclusiveDescription": "FLAC/WAV PCM के लिए ट्रैक की मूल दर और सटीकता पर Oboe/AAudio का उपयोग करें। Android 8.1 या नया संस्करण और संगत हार्डवेयर चाहिए। एक्सक्लूसिव एक्सेस की जाँच होती है; उपलब्ध न होने वाले फ़ॉर्मेट सामान्य प्लेबैक से चलेंगे। DSD के लिए सीधा USB ड्राइवर चाहिए। अगले ट्रैक से लागू होगा।",
  "dapExclusiveUnavailable": "इस ट्रैक और मौजूदा आउटपुट के लिए AAudio एक्सक्लूसिव एक्सेस उपलब्ध नहीं है। सामान्य प्लेबैक का उपयोग हो रहा है। USB DAC के लिए सीधा USB ड्राइवर आज़माएँ।",
  "usbDirect": "सीधा USB ड्राइवर",
  "usbDirectDescription": "Android USB अनुमति के साथ FLAC/WAV, DSF/DFF और WavPack DSD के लिए एक्सक्लूसिव USB ऑडियो का उपयोग करें। नेटिव DSD के लिए पहचाना गया संगत DAC चाहिए। अन्य PCM फ़ॉर्मेट सामान्य प्लेबैक से चलेंगे। अगले ट्रैक से लागू होगा।",
  "usbDsdOverPcm": "PCM पर DSD (DoP)",
  "usbDsdOverPcmDescription": "केवल तभी चालू करें जब आपका DAC DoP को स्पष्ट रूप से समर्थित करता हो। नेटिव DSD उपलब्ध न होने पर DSF/DFF और WavPack DSD को PCM कैरियर के अंदर भेजता है। असंगत उपकरण शोर चला सकता है; सामान्य USB हेडसेट के लिए बंद रखें।",
  "usbDsdUnsupported": "यह DSD फ़ॉर्मेट या जुड़ा DAC समर्थित नहीं है। प्लेबैक रोक दिया गया।",
  "usbPermissionDenied": "USB अनुमति नहीं दी गई। सामान्य प्लेबैक का उपयोग हो रहा है।",
  "usbBitPerfectPending": "अगले ट्रैक और संगत USB आउटपुट की प्रतीक्षा है।",
  "usbBitPerfectNoDevice": "कोई USB DAC कनेक्ट नहीं है। सामान्य ऑडियो आउटपुट का उपयोग हो रहा है।",
  "usbBitPerfectFallback": "यह डिवाइस या ऑडियो फ़ॉर्मेट bit-perfect आउटपुट का समर्थन नहीं करता। सामान्य प्लेबैक का उपयोग हो रहा है।",
